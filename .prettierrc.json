{
  "useTabs": true,
  "tabWidth": 4,
  "printWidth": 140,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "none",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.json", "*.yml", "*.yaml"],
      "options": { "useTabs": false, "tabWidth": 2 }
    }
  ]
}
